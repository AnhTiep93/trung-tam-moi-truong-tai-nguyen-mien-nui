# File này dùng cho phương án VPS tự quản (docker-compose) — copy thành ".env" ở gốc
# dự án trên VPS, điền giá trị thật, rồi chạy: docker compose up -d --build
#
# Nếu dùng Vercel + Railway/Render (không VPS): các biến bên dưới vẫn cần khai báo,
# nhưng nhập trực tiếp vào dashboard của từng nền tảng, không dùng file này. Riêng
# database, Railway/Render cấp sẵn 1 biến DATABASE_URL — map thẳng vào thay vì
# DATABASE_NAME/USERNAME/PASSWORD, và luôn thêm DATABASE_SSL_REJECT_UNAUTHORIZED=false
# (Postgres managed của họ dùng chứng chỉ tự ký). Xem README mục "Triển khai production
# (PaaS)" để biết chi tiết từng bước.

############################################
# Domain (Caddy sẽ tự xin chứng chỉ HTTPS Let's Encrypt cho các domain này)
############################################
SITE_DOMAIN=example.com
CMS_DOMAIN=cms.example.com

############################################
# Frontend (Next.js) — build-time + runtime
############################################
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_STRAPI_URL=https://cms.example.com

############################################
# CMS (Strapi) — bắt buộc đổi hết secrets khi lên production,
# KHÔNG dùng chung secrets với môi trường dev.
# Sinh secrets mới: openssl rand -base64 32
############################################
HOST=0.0.0.0
PORT=1337
PUBLIC_URL=https://cms.example.com
FRONTEND_URL=https://example.com

APP_KEYS=change-me-1,change-me-2,change-me-3,change-me-4
API_TOKEN_SALT=change-me
ADMIN_JWT_SECRET=change-me
JWT_SECRET=change-me
TRANSFER_TOKEN_SALT=change-me
ENCRYPTION_KEY=change-me

############################################
# Database (Postgres + PostGIS — dùng chung giữa service "postgres" và "cms")
############################################
DATABASE_NAME=cemr
DATABASE_USERNAME=cemr
DATABASE_PASSWORD=change-me
DATABASE_SSL=false

############################################
# Email (SMTP thật để gửi email xác nhận/thông báo — xem cms/.env.example)
############################################
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.com
EMAIL_TO=
