{
  "kind": "collectionType",
  "collectionName": "gis_layers",
  "info": {
    "singularName": "gis-layer",
    "pluralName": "gis-layers",
    "displayName": "GIS Layer",
    "description": "Lớp dữ liệu bản đồ cho WebGIS (MVP: lưu GeoJSON trực tiếp, nâng cấp lên PostGIS sau)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "ranh-gioi-hanh-chinh",
        "rung",
        "dat",
        "song-suoi",
        "giao-thong",
        "hien-trang-su-dung-dat",
        "quy-hoach",
        "moi-truong",
        "khi-hau",
        "thien-tai"
      ],
      "required": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "description": {
      "type": "text"
    },
    "color": {
      "type": "string",
      "default": "#1f6d45",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "fillOpacity": {
      "type": "decimal",
      "default": 0.35,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "defaultVisible": {
      "type": "boolean",
      "default": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "order": {
      "type": "integer",
      "default": 0,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "geojson": {
      "type": "json",
      "required": true,
      "pluginOptions": { "i18n": { "localized": false } }
    }
  }
}
