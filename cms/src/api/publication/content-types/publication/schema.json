{
  "kind": "collectionType",
  "collectionName": "publications",
  "info": {
    "singularName": "publication",
    "pluralName": "publications",
    "displayName": "Publication",
    "description": "Sản phẩm khoa học: bài báo, sách, giáo trình, báo cáo, bản đồ, CSDL, phần mềm, sáng chế"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "bai-bao",
        "sach",
        "giao-trinh",
        "bao-cao",
        "ban-do",
        "co-so-du-lieu",
        "phan-mem",
        "sang-che"
      ],
      "required": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "authors": {
      "type": "string"
    },
    "year": {
      "type": "integer",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "summary": {
      "type": "text"
    },
    "externalLink": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "file": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["files"],
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "relatedProject": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::project.project"
    }
  }
}
