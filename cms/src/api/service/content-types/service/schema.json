{
  "kind": "collectionType",
  "collectionName": "services",
  "info": {
    "singularName": "service",
    "pluralName": "services",
    "displayName": "Service",
    "description": "Nhóm dịch vụ tư vấn / chuyển giao công nghệ"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "group": {
      "type": "enumeration",
      "enum": [
        "gis-webgis",
        "do-dac-ban-do",
        "tai-nguyen-dat",
        "moi-truong",
        "quy-hoach",
        "carbon"
      ],
      "required": true,
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "summary": {
      "type": "text"
    },
    "description": {
      "type": "richtext"
    },
    "icon": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "pluginOptions": { "i18n": { "localized": false } }
    },
    "order": {
      "type": "integer",
      "default": 0,
      "pluginOptions": { "i18n": { "localized": false } }
    }
  }
}
