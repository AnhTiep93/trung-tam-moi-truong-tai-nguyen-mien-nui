{
  "kind": "collectionType",
  "collectionName": "course_registrations",
  "info": {
    "singularName": "course-registration",
    "pluralName": "course-registrations",
    "displayName": "Course Registration",
    "description": "Đăng ký khóa đào tạo"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "fullName": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "phone": {
      "type": "string"
    },
    "organization": {
      "type": "string"
    },
    "course": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::training-course.training-course"
    },
    "note": {
      "type": "text"
    },
    "status": {
      "type": "enumeration",
      "enum": ["moi", "da-lien-he", "hoan-thanh"],
      "default": "moi"
    }
  }
}
